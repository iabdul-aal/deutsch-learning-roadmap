{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CurriculumDataSchema",
  "type": "object",
  "required": ["title", "totalWeeks", "totalDays", "weeks"],
  "properties": {
    "title": { "type": "string" },
    "totalWeeks": { "type": "integer", "enum": [8] },
    "totalDays": { "type": "integer", "enum": [56] },
    "weeks": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": ["weekNumber", "title", "objective", "summary", "days"],
        "properties": {
          "weekNumber": { "type": "integer", "minimum": 1, "maximum": 8 },
          "title": { "type": "string" },
          "objective": { "type": "string" },
          "summary": { "type": "string" },
          "days": {
            "type": "array",
            "minItems": 7,
            "maxItems": 7,
            "items": {
              "type": "object",
              "required": ["dayNumber", "title", "focusSkill", "objective", "standardTasks"],
              "properties": {
                "dayNumber": { "type": "integer", "minimum": 1, "maximum": 56 },
                "title": { "type": "string" },
                "focusSkill": { "type": "string" },
                "objective": { "type": "string" },
                "standardTasks": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "required": ["type", "title"],
                    "properties": {
                      "type": { "type": "string" },
                      "title": { "type": "string" },
                      "duration": { "type": "string" },
                      "resourceType": { "type": "string" },
                      "link": { "type": "string" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
