{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SurvivalDataSchema",
  "type": "object",
  "required": ["title", "categories"],
  "properties": {
    "title": { "type": "string" },
    "categories": {
      "type": "array",
      "minItems": 7,
      "items": {
        "type": "object",
        "required": ["id", "title", "phrases"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "phrases": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "german", "arabic", "phonetic", "example", "roleplay"],
              "properties": {
                "id": { "type": "string" },
                "german": { "type": "string" },
                "arabic": { "type": "string" },
                "phonetic": { "type": "string" },
                "example": { "type": "string" },
                "roleplay": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
